---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'ghenv — Dev secrets. Delivered locally.',
	description = 'Run local commands with explicitly approved GitHub Preview credentials. An encrypted handoff from GitHub Actions to your process environment, without a local .env file.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'ghenv',
	url: Astro.site,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Linux, macOS',
	codeRepository: 'https://github.com/nicodes/ghenv',
	description,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f6ef" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ghenv" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
